{
  "name": "@toshihiko/base-adapter",
  "version": "2.0.0-alpha.0",
  "description": "Promise-only typed adapter foundation for Toshihiko v2.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "author": "XadillaX <i@2333.moe>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toshihikojs/Toshihiko.git",
    "directory": "packages/base-adapter"
  },
  "bugs": {
    "url": "https://github.com/toshihikojs/Toshihiko/issues"
  },
  "homepage": "https://github.com/toshihikojs/Toshihiko/tree/v2/packages/base-adapter#readme",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "toshihiko": ">=2.0.0-alpha.0 <3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "toshihiko": "2.0.0-alpha.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run typecheck && npm run build && npm run test:package",
    "test:package": "tsc -p test/package/tsconfig.json && node --test test/package/runtime.test.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "npm ls",
    "prepublishOnly": "npm test"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "eventemitter2": "^6.0.0",
    "lodash": "4.17.21"
  }
}
