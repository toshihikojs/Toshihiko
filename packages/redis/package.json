{
  "name": "@toshihiko/redis-cache",
  "version": "2.0.0-alpha.0",
  "description": "Promise-only Redis cache for Toshihiko v2.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "author": "luicfer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toshihikojs/Toshihiko.git",
    "directory": "packages/redis"
  },
  "bugs": {
    "url": "https://github.com/toshihikojs/Toshihiko/issues"
  },
  "homepage": "https://github.com/toshihikojs/Toshihiko/tree/v2/packages/redis#readme",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "toshihiko": ">=2.0.0-alpha.0 <3"
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "toshihiko": "2.0.0-alpha.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:test": "npm run clean:test && tsc -p tsconfig.test.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean:test": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "test": "npm run typecheck && npm run build && npm run test:unit",
    "test:unit": "npm run build:test && node --test .test-dist/unit/*.test.js",
    "test:integration": "npm run build:test && node --test .test-dist/integration/*.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "npm ls",
    "prepublishOnly": "npm test"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
