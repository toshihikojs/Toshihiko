{
  "name": "toshihiko",
  "version": "2.0.0-alpha.0",
  "description": "Yet another simple ORM for Node.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toshihikojs/Toshihiko.git",
    "directory": "packages/toshihiko"
  },
  "bugs": {
    "url": "https://github.com/toshihikojs/Toshihiko/issues"
  },
  "homepage": "https://github.com/toshihikojs/Toshihiko/tree/v2/packages/toshihiko#readme",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run typecheck && npm run build && npm run test:package",
    "test:package": "tsc -p test/package/tsconfig.json && node --test test/package/runtime.test.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "npm ls",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
