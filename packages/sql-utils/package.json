{
  "name": "@toshihiko/sql-utils",
  "version": "1.1.2",
  "description": "SQL string utils for Toshihiko.js.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "XadillaX <i@2333.moe>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toshihikojs/Toshihiko.git",
    "directory": "packages/sql-utils"
  },
  "bugs": {
    "url": "https://github.com/toshihikojs/Toshihiko/issues"
  },
  "homepage": "https://github.com/toshihikojs/Toshihiko/tree/master/packages/sql-utils#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "c8": "^12.0.0",
    "cheerio": "^1.0.0",
    "eslint": "^8.57.1",
    "eslint-config-egg": "^14.0.0",
    "eslint-plugin-import": "^2.30.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "npm run gen-keywords && tsc -p ./tsconfig.src.json",
    "build:test": "npm run clean:test && tsc -p tsconfig.test.json",
    "clean:test": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "npm run build:test && node --experimental-test-coverage --test --test-concurrency=1 --test-coverage-exclude='.test-dist/test/**' .test-dist/test/*.test.js",
    "test:coverage": "npm run build && npm run typecheck && npm run build:test && c8 --src=.test-dist/src --include='.test-dist/src/**/*.js' node --test --test-concurrency=1 .test-dist/test/*.test.js",
    "gen-keywords": "ts-node tools/keywords/extract.ts",
    "prepublishOnly": "npm run build",
    "prepare": "npm run gen-keywords"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
